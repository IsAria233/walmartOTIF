POSTGRES_USER=otif
POSTGRES_PASSWORD=change-me
POSTGRES_DB=otif
# Must be at least 32 bytes, e.g. python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
AUTH_DEMO_PASSWORD_HASH=
# Model provider and LangFuse (never commit real keys)
ANTHROPIC_API_KEY=
# Optional: defaults to claude-haiku-5-5
AGENT_MODEL=
# Optional outside Docker: Postgres for investigation checkpoints, e.g.
# postgresql://otif:change-me@localhost:5432/otif. Compose sets it; without it runs are kept in memory.
AGENT_CHECKPOINT_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com  US: https://us.cloud.langfuse.com (must match the project region)
LANGFUSE_HOST=https://us.cloud.langfuse.com
